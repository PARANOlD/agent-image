# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# --- Ollama / Qwen ---
# qwen2.5-coder:14b-instruct-q4_K_M (~9GB weights, ~13GB loaded at 24k
# context) -- the goal model: coding-specialized, and on the RTX 5060 Ti
# (16GB) it beat llama3.1:8b head-to-head, 3x faster at comparable-or-better
# code quality. Also used by intent_gate.py's thread-reply classifier.
#
# Tradeoff: no real tool-calling. Every Qwen2.5-Coder size tested (1.5b/3b/
# 14b) never emits real tool_calls via Ollama regardless of size -- a gap in
# that model family's Ollama packaging. llama3.1:8b does emit real tool_calls
# (with native_tool_calling: true in openhands_client.py's LLM config), so
# it's the fallback if a task genuinely needs live model-driven tool use --
# swap this one line. Concrete actions we've already built (PR lookups) are
# deterministic Python instead (github_actions.py), which doesn't care which
# model is active.
OLLAMA_MODEL=qwen2.5-coder:14b-instruct-q4_K_M
# OpenHands' agent loop needs a large context window (its own docs recommend
# >=22000) or it fails on long tool-call histories/system prompts.
OLLAMA_CONTEXT_LENGTH=24576
# Request slots. Ollama sizes its KV cache as context_length * num_parallel,
# so raising this multiplies VRAM use and can tip a model into a silent
# 100% CPU fallback. Leave at 1 unless you have VRAM to spare.
OLLAMA_NUM_PARALLEL=1

# --- GitHub (source control + ticketing, via a GitHub App -- not a PAT) ---
# From the app's settings page.
GITHUB_APP_ID=
# Filename only (not a full path) of the .pem you downloaded into ./secrets/ --
# chat-bridge mounts that whole directory read-only and looks for it there.
GITHUB_APP_PRIVATE_KEY_FILENAME=gary-app.pem
# From github.com/settings/installations -> click the app -> the number in the URL.
GITHUB_APP_INSTALLATION_ID=
# Comma-separated owner/repo list the chat-bridge polls for @agent mentions.
GITHUB_REPOS=owner/repo1,owner/repo2
# Mention string the GitHub poller reacts to (case-insensitive substring match).
GITHUB_TRIGGER=@agent
# Poll interval in seconds.
GITHUB_POLL_INTERVAL=30
# Installation token for the openhands container's own git operations (clone/push).
# Installation tokens expire hourly -- minted by scripts/mint-github-app-token.sh,
# which writes it here. Re-run that script + `docker compose restart openhands`
# when it goes stale. (chat-bridge's own GitHub calls don't use this -- the
# poller mints its own token per-request via github_app_auth.py.)
GITHUB_TOKEN=

# --- Slack ---
# From api.slack.com/apps -> OAuth & Permissions (starts xoxb-).
SLACK_BOT_TOKEN=
# From Basic Information -> App-Level Tokens, with connections:write scope (starts xapp-).
SLACK_APP_TOKEN=
# From Basic Information -> App Credentials -> Signing Secret. Not actually
# used for verification in Socket Mode (no inbound HTTP requests), but
# slack_bolt's App() requires a non-empty value regardless.
SLACK_SIGNING_SECRET=
# Channel ID (not name) Gary posts a "Version X, model: Y" message to on every
# chat-bridge (re)start/redeploy. Right-click a channel -> View channel details
# to find its ID. Leave blank to skip the announcement.
SLACK_STATUS_CHANNEL=

# --- OpenHands (openhands-agent-server, run standalone via REST API) ---
# Resolved by scripts/pin-versions.sh -- leave blank to use the default below.
OPENHANDS_IMAGE=
OLLAMA_IMAGE=
# Required: any random string, e.g. `openssl rand -hex 32`. Sent by chat-bridge
# as the X-Session-API-Key header; set on the openhands container as
# OH_SESSION_API_KEYS_0.
OPENHANDS_API_KEY=
# Optional: encrypts secrets the agent server stores internally.
OPENHANDS_SECRET_KEY=

# --- Azure Container Registry ---
# e.g. myregistry (no .azurecr.io suffix)
ACR_NAME=
