#!/usr/bin/env bash
# Git credential helper: answers github.com credential requests with a
# short-lived GitHub App installation token, minted on demand from the
# GITHUB_APP_* settings in .env.
#
# Nothing secret is stored where git can see it. The token exists only for
# the duration of the push and expires within the hour, so there is no
# long-lived PAT to leak. Minting reuses the same code chat-bridge uses
# (github_app_auth.py via mint_token.py), run in the chat-bridge image so the
# host needs no Python dependencies.
#
# Wired up per-repo by scripts/setup-git-auth.sh.
set -euo pipefail

# Git also calls helpers with "store" and "erase"; we have nothing to persist.
[ "${1:-}" = "get" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0

cd "$(dirname "$(readlink -f "$0")")/.."

if ! token=$(docker compose run --rm --no-deps -T chat-bridge python mint_token.py 2>/dev/null) \
   || [ -z "$token" ]; then
  echo "git-credential-gary: could not mint a GitHub App token (is the chat-bridge image built and .env filled in?)" >&2
  exit 0
fi

echo "username=x-access-token"
echo "password=${token}"
